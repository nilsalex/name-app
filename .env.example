# Copy to .env.local and fill in real values. NEVER commit .env.local.
# In production (Vercel): set the same names in Settings > Environment Variables.

# --- Vote storage (Upstash Redis free tier) ---
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# --- Gmail login (features 004/005) ---
# OAuth client ID from Google Cloud Console (public by design).
# Authorized JavaScript origins: http://localhost:3000 + production URL.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Comma-separated approved addresses (secret). Append to add a user —
# no code change, no data migration. Order no longer decides identity:
# each approved address becomes a permanent internal user ID at first
# sign-in; display labels ("Person 1", "Person 2", …) follow first-sign-in
# order. Trimming/case-insensitive; at least one address required.
APPROVED_EMAILS=person.a@gmail.com,person.b@gmail.com
# HMAC key for the session cookie: at least 32 random bytes.
# Generate: openssl rand -base64 32
SESSION_SECRET=
